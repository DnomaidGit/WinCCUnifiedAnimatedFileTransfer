          "defaultheight": 200,
          "unit": "px"
        }
      },
      "extensions": {
        "HMI": {
          "mandatory": true,
          "version": "~1.0.0"
        }
      }
    },
    "metadata": {
      "author": "Quimet",
      "keywords": ["Animated", "File", "Transfer", "SVG", "Animation", "WinCC Unified"],
      "homepage": "https://github.com/DnomaidGit",
      "company": "Dnomaid"
    },
    "contracts": {
      "api": {
        "methods": {},
        "events": {},
        "properties": {
          "Start": {"type": "boolean", "default": false},
          "End": {"type": "boolean", "default": false},
          "AnimationTime": {"type": "number", "default": 2500},
          "SourceFolderName": {"type": "string", "default": "Source"},
          "DestinationFolderName": {"type": "string", "default": "Destination"},
          "FileName": {"type": "string", "default": "File.txt"}
        }
      }
    },
    "types": {}
  }
