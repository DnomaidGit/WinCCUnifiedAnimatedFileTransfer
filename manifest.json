{
  "$schema": "./CWC_manifest_Schema.json",
  "mver": "1.2.0",
  "control": {
    "identity": {
      "name": "WinCCUnifiedAnimatedFileTransfer",
      "version": "1.1.0",
      "displayname": "Animated File Transfer",
      "icon": "./assets/filetransfer.ico",
      "type": "guid://7C42387C-4FC2-4607-8200-A423E4580F23",
      "start": "./control/index.html"
    },
    "environment": {
      "prerequisites": {
